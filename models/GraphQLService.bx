/**
 * Builds and holds the graphql.GraphQL engine: parses/merges the consumer's SDL files,
 * adds the SDL generated from annotated classes (SchemaGenerator), and wires
 * convention-based DataFetchers. Built once at construction time — not per request.
 * No WireBox; settings are passed directly to init().
 *
 * Deferred: interface/union TypeResolver wiring, introspection toggle.
 */
class {

	property name="settings";

	variables.javaClass    = "";
	variables.engine       = "";
	variables.classFiles   = "";
	variables.generatedSDL = "";

	function init( required struct settings ){
		variables.settings  = arguments.settings;
		variables.javaClass  = new "JavaClassFactory"();
		variables.classFiles = new "ClassFiles"();
		buildSchema();
		return this;
	}

	any function getEngine(){
		return variables.engine;
	}

	any function getSchema(){
		return variables.engine.getGraphQLSchema();
	}

	/** The SDL generated from modelPaths and servicePaths; "" when neither is set. */
	string function getGeneratedSDL(){
		return variables.generatedSDL;
	}

	/** The whole executable schema as SDL, hand-written and generated together. */
	string function printSchema(){
		return variables.javaClass.create( "graphql.schema.idl.SchemaPrinter" ).init().print( getSchema() );
	}

	/**
	 * Executes a query/mutation and returns a plain CFML struct — {data, errors} — so
	 * callers never need to touch graphql-java classes directly.
	 */
	struct function execute( required string query, struct queryVariables = {}, any context = "" ){
		var executionInputBuilder = variables.javaClass.create( "graphql.ExecutionInput" )
			.newExecutionInput()
			.query( arguments.query )
			.context( arguments.context )

		if( !structIsEmpty( arguments.queryVariables ) ){
			executionInputBuilder = executionInputBuilder.variables( toJavaMap( arguments.queryVariables ) )
		}

		var result = variables.engine.execute( executionInputBuilder.build() )

		return {
			"data"   : result.getData(),
			"errors" : arrayMap( result.getErrors() ?: [], ( e ) => e.getMessage() )
		};
	}

	/**
	 * graphql-java's internal variable coercion does a plain `Map.get(String)`
	 * lookup against whatever's passed to ExecutionInput.Builder.variables() —
	 * a real java.util.Map, not BoxLang's own Struct type, which implements
	 * `java.util.Map` but doesn't satisfy foreign Java code calling get() with
	 * a plain java.lang.String key (confirmed directly: a BoxLang struct
	 * passed straight through is non-empty and serializes fine, but every
	 * variable in it comes back coerced to null once graphql-java tries to
	 * read it — a real java.util.HashMap with identical contents works).
	 * So: copy into a genuine HashMap before it ever reaches graphql-java —
	 * all the way down. An input object variable is a struct nested inside
	 * this one, and a list variable an array; left as BoxLang types, graphql-java
	 * fails coercing them (a ClassCastException on the struct's Key keys).
	 */
	private any function toJavaMap( required struct source ){
		return toJavaValue( arguments.source );
	}

	/** Structs become java.util.HashMaps with String keys, arrays java.util.ArrayLists, recursively; anything else as-is. */
	private any function toJavaValue( any value ){
		if( isNull( arguments.value ) ){
			return javaCast( "null", "" );
		}
		if( isStruct( arguments.value ) ){
			var javaMap = variables.javaClass.create( "java.util.HashMap" ).init();
			for( var key in arguments.value ){
				var member = arguments.value[ key ] ?: javaCast( "null", "" );
				javaMap.put( toString( key ), isNull( member ) ? javaCast( "null", "" ) : toJavaValue( member ) );
			}
			return javaMap;
		}
		if( isArray( arguments.value ) ){
			var javaList = variables.javaClass.create( "java.util.ArrayList" ).init();
			for( var member in arguments.value ){
				javaList.add( isNull( member ) ? javaCast( "null", "" ) : toJavaValue( member ) );
			}
			return javaList;
		}
		return arguments.value;
	}

	private void function buildSchema(){
		validateSettings();

		var schemaFiles = resolveSchemaFiles( variables.settings.schemaPaths ?: [] );
		if( hasSetting( "schemaPaths" ) && arrayLen( schemaFiles ) == 0 ){
			throw(
				type    = "BxGraphQL.ConfigurationException",
				message = "schemaPaths did not resolve to any .graphqls files.",
				detail  = "Paths checked: " & arrayToList( variables.settings.schemaPaths, ", " )
			);
		}

		var mergedRegistry = parseAndMergeSchemas( schemaFiles );
		var generated      = new "SchemaGenerator"( variables.classFiles ).generate(
			modelPaths        = variables.settings.modelPaths ?: [],
			servicePaths      = variables.settings.servicePaths ?: [],
			existingTypeNames = declaredNamesIn( mergedRegistry )
		);
		variables.generatedSDL = generated.sdl;

		try {
			if( len( generated.sdl ) ){
				mergedRegistry = mergedRegistry.merge( variables.javaClass.create( "graphql.schema.idl.SchemaParser" ).init().parse( generated.sdl ) );
			}

			var runtimeWiringBuilder = variables.javaClass.create( "graphql.schema.idl.RuntimeWiring" ).newRuntimeWiring();
			wireScalars( runtimeWiringBuilder, mergedRegistry );
			wireResolvers( runtimeWiringBuilder, mergedRegistry, generated );

			var graphQLSchema = variables.javaClass.create( "graphql.schema.idl.SchemaGenerator" ).init()
				.makeExecutableSchema( mergedRegistry, runtimeWiringBuilder.build() );
		} catch( "BxGraphQL.ConfigurationException" e ){
			rethrow;
		} catch( any e ){
			// with nothing generated, graphql-java's own error is the whole story, as before
			if( !len( generated.sdl ) ){
				rethrow;
			}
			throw(
				type    = "BxGraphQL.ConfigurationException",
				message = "The schema generated from modelPaths/servicePaths doesn't fit: " & e.message,
				detail  = generated.sdl
			);
		}

		variables.engine = variables.javaClass.create( "graphql.GraphQL" ).newGraphQL( graphQLSchema ).build();
	}

	private boolean function hasSetting( required string name ){
		return isArray( variables.settings[ arguments.name ] ?: "" ) && arrayLen( variables.settings[ arguments.name ] ) > 0;
	}

	private array function declaredNamesIn( required any typeRegistry ){
		var names = [];
		arrayAppend( names, arguments.typeRegistry.types().keySet().toArray(), true );
		arrayAppend( names, arguments.typeRegistry.scalars().keySet().toArray(), true );
		return names.map( ( name ) => toString( name ) );
	}

	/**
	 * A schema has to come from somewhere: .graphqls files (schemaPaths), annotated
	 * classes (modelPaths, servicePaths), or both. Without annotated classes every
	 * resolver is a {Type}Resolver.bx, so resolverBasePackage is required, as it
	 * always was; with them it is optional.
	 */
	private void function validateSettings(){
		for( var name in [ "schemaPaths", "modelPaths", "servicePaths" ] ){
			if( structKeyExists( variables.settings, name ) && !isArray( variables.settings[ name ] ) ){
				throw( type = "BxGraphQL.ConfigurationException", message = "#name# must be an array of paths." );
			}
		}
		var codeFirst = hasSetting( "modelPaths" ) || hasSetting( "servicePaths" );
		if( !hasSetting( "schemaPaths" ) && !codeFirst ){
			throw(
				type    = "BxGraphQL.ConfigurationException",
				message = "No schemaPaths configured for bx-graphql."
			);
		}
		if( !codeFirst && !len( trim( variables.settings.resolverBasePackage ?: "" ) ) ){
			throw(
				type    = "BxGraphQL.ConfigurationException",
				message = "No resolverBasePackage configured for bx-graphql."
			);
		}
		if( structKeyExists( variables.settings, "instanceFactory" ) && !isFunctionValue( variables.settings.instanceFactory ) ){
			throw( type = "BxGraphQL.ConfigurationException", message = "instanceFactory must be a function: ( classPath, meta ) => instance." );
		}
	}

	/**
	 * resolverBasePackage follows the same convention as the ColdBox edition of this
	 * module — a dotted package path (e.g. "models.resolvers"), resolved relative to the
	 * consuming app's entry point. A value containing "/" is treated as an already-literal
	 * path instead (e.g. for a resolvers folder outside any dotted package root) and left
	 * as-is aside from expandPath().
	 */
	private string function normalizeResolverBasePackage( required string resolverBasePackage ){
		var normalized = trim( arguments.resolverBasePackage );
		if( !len( normalized ) ){
			return "";
		}
		if( !find( "/", normalized ) && !find( "\", normalized ) ){
			normalized = replace( normalized, ".", "/", "all" );
		}
		return expandPath( normalized );
	}

	private array function resolveSchemaFiles( required array configuredPaths ){
		var resolved = [];

		for( var rawPath in arguments.configuredPaths ){
			var expandedPath = expandPath( rawPath );

			if( directoryExists( expandedPath ) ){
				arrayAppend( resolved, directoryList( expandedPath, false, "path", "*.graphqls" ), true );
			} else if( find( "*", expandedPath ) ){
				var baseDir = getDirectoryFromPath( expandedPath );
				var filter  = getFileFromPath( expandedPath );
				if( directoryExists( baseDir ) ){
					arrayAppend( resolved, directoryList( baseDir, false, "path", filter ), true );
				} else {
					throw(
						type    = "BxGraphQL.ConfigurationException",
						message = "Configured schema path does not exist: " & rawPath & " (resolved directory " & baseDir & " does not exist)"
					);
				}
			} else if( fileExists( expandedPath ) ){
				arrayAppend( resolved, expandedPath );
			} else {
				throw(
					type    = "BxGraphQL.ConfigurationException",
					message = "Configured schema path does not exist: " & rawPath & " (resolved to " & expandedPath & ")"
				);
			}
		}

		return resolved;
	}

	private any function parseAndMergeSchemas( required array schemaFiles ){
		var schemaParser   = variables.javaClass.create( "graphql.schema.idl.SchemaParser" ).init();
		var mergedRegistry = variables.javaClass.create( "graphql.schema.idl.TypeDefinitionRegistry" ).init();

		for( var filePath in arguments.schemaFiles ){
			var sdl      = fileRead( filePath );
			var registry = schemaParser.parse( sdl );
			mergedRegistry = mergedRegistry.merge( registry );
		}

		return mergedRegistry;
	}

	/**
	 * Every scalar the schema declares needs its conversions: from settings.scalars
	 * first, then the module's own (BuiltInScalars). typeRegistry.scalars() also
	 * lists the five the GraphQL spec defines, which graphql-java wires itself.
	 */
	private void function wireScalars( required any runtimeWiringBuilder, required any typeRegistry ){
		var configured = variables.settings.scalars ?: {};
		if( !isStruct( configured ) ){
			throw( type = "BxGraphQL.ConfigurationException", message = "scalars must be a struct of { ScalarName : { serialize, parseValue } }." );
		}

		for( var scalarName in arguments.typeRegistry.scalars().keySet().toArray() ){
			if( arrayContains( [ "Int", "Float", "String", "Boolean", "ID" ], scalarName ) ){
				continue;
			}
			var handlers = configured[ scalarName ] ?: new "BuiltInScalars"().handlersFor( scalarName );
			if( !isStruct( handlers ) || !isFunctionValue( handlers.serialize ?: "" ) || !isFunctionValue( handlers.parseValue ?: "" ) ){
				throw(
					type    = "BxGraphQL.ConfigurationException",
					message = "The schema declares scalar #scalarName#, which needs settings.scalars.#scalarName# = { serialize, parseValue } (functions taking the one value)."
				);
			}

			var coercing = createDynamicProxy(
				new "ScalarCoercing"( scalarName = scalarName, handlers = handlers, javaClass = variables.javaClass ),
				"graphql.schema.Coercing"
			);
			arguments.runtimeWiringBuilder.scalar(
				variables.javaClass.create( "graphql.schema.GraphQLScalarType" ).newScalar().name( scalarName ).coercing( coercing ).build()
			);
		}
	}

	private boolean function isFunctionValue( any value ){
		return isCustomFunction( arguments.value ) || isClosure( arguments.value );
	}

	/**
	 * Every object type gets the convention as its default fetcher ({Type}Resolver.bx,
	 * else the field read off the parent). A field generated from a service method
	 * gets that method instead.
	 */
	private void function wireResolvers( required any runtimeWiringBuilder, required any typeRegistry, required struct generated ){
		var entryIterator       = arguments.typeRegistry.types().entrySet().iterator();
		var resolverBasePackage = normalizeResolverBasePackage( variables.settings.resolverBasePackage ?: "" );
		var instances           = {};

		while( entryIterator.hasNext() ){
			var entry = entryIterator.next();
			if( !isInstanceOf( entry.getValue(), "graphql.language.ObjectTypeDefinition" ) ){
				continue;
			}
			var typeName = entry.getKey();

			var adapter = new "DataFetcherAdapter"(
				typeName            = typeName,
				resolverBasePackage = resolverBasePackage,
				javaClass           = variables.javaClass
			);
			var typeWiringBuilder = variables.javaClass.create( "graphql.schema.idl.TypeRuntimeWiring" )
				.newTypeWiring( typeName )
				.defaultDataFetcher( createDynamicProxy( adapter, "graphql.schema.DataFetcher" ) );

			for( var operation in arguments.generated.operations ){
				if( operation.rootType != typeName ){
					continue;
				}
				if( !structKeyExists( instances, operation.classPath ) ){
					instances[ operation.classPath ] = serviceInstance( operation.classPath );
				}
				var fetcher = new "MethodDataFetcher"(
					instance   = instances[ operation.classPath ],
					methodName = operation.methodName,
					parameters = operation.parameters,
					models     = arguments.generated.models,
					classFiles = variables.classFiles
				);
				typeWiringBuilder = typeWiringBuilder.dataFetcher( operation.fieldName, createDynamicProxy( fetcher, "graphql.schema.DataFetcher" ) );
			}

			arguments.runtimeWiringBuilder.type( typeWiringBuilder.build() );
		}
	}

	private any function serviceInstance( required string classPath ){
		if( !structKeyExists( variables.settings, "instanceFactory" ) ){
			return variables.classFiles.instantiate( arguments.classPath );
		}
		var instance = variables.settings.instanceFactory( arguments.classPath, variables.classFiles.metadataOf( arguments.classPath ) );
		if( isNull( instance ) || !isObject( instance ) ){
			throw( type = "BxGraphQL.ConfigurationException", message = "instanceFactory returned no instance for #arguments.classPath#." );
		}
		return instance;
	}

}
