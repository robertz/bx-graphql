/**
 * Bridges a single graphql-java DataFetcher call to a plain BoxLang resolver class, per
 * the module's resolver convention. One instance is created per schema type at
 * schema-build time and wrapped as a Java graphql.schema.DataFetcher via createDynamicProxy.
 *
 * Convention: {resolverBasePackage}/{TypeName}Resolver.bx, method {fieldName}().
 * Falls back to graphql-java's PropertyDataFetcher when no resolver class exists, or the
 * resolver class exists but doesn't implement the specific field method.
 *
 * No DI container here (no WireBox equivalent) — resolver existence is checked by
 * fileExists() against the configured resolverBasePackage directory, then instantiated
 * directly via new, rather than by pattern-matching a framework's not-found exception.
 *
 * BoxLang's `new "path"()` only resolves paths relative to the FILE the `new` call is
 * written in (confirmed empirically — there is no absolute-filesystem-path form, and
 * createObject("component", ...) has the same restriction). resolverBasePackage arrives
 * as an absolute directory, so it's converted to a path relative to this file's own
 * directory before every `new` call.
 */
class {

	property name="typeName";
	property name="resolverBasePackage";
	property name="javaClass";

	variables.resolverInstance         = "";
	variables.hasResolver              = false;
	variables.resolverChecked          = false;
	variables.propertyDataFetcherCache = {};
	variables.selfDirectory            = getDirectoryFromPath( getCurrentTemplatePath() );

	function init(
		required string typeName,
		required string resolverBasePackage,
		required any javaClass
	){
		variables.typeName            = arguments.typeName;
		variables.resolverBasePackage = arguments.resolverBasePackage;
		variables.javaClass           = arguments.javaClass;
		return this;
	}

	/**
	 * Single abstract method of graphql.schema.DataFetcher.
	 * `environment` is a raw graphql.schema.DataFetchingEnvironment.
	 */
	any function get( required any environment ){
		var fieldName = arguments.environment.getField().getName();

		ensureResolverResolved();

		if( variables.hasResolver && structKeyExists( variables.resolverInstance, fieldName ) ){
			return variables.resolverInstance[ fieldName ](
				source  = arguments.environment.getSource(),
				args    = JSONDeserialize( JSONSerialize( arguments.environment.getArguments() ) ),
				context = arguments.environment.getContext(),
				env     = arguments.environment
			);
		}

		if( !structKeyExists( variables.propertyDataFetcherCache, fieldName ) ){
			variables.propertyDataFetcherCache[ fieldName ] = variables.javaClass.create( "graphql.schema.PropertyDataFetcher" ).fetching( fieldName );
		}
		return variables.propertyDataFetcherCache[ fieldName ].get( arguments.environment );
	}

	private void function ensureResolverResolved(){
		if( variables.resolverChecked ){
			return;
		}
		variables.resolverChecked = true;

		var resolverPath = variables.resolverBasePackage & "/" & variables.typeName & "Resolver";
		if( !fileExists( expandPath( resolverPath & ".bx" ) ) ){
			variables.hasResolver = false;
			return;
		}

		variables.resolverInstance = new "#toRelativePath( resolverPath )#"();
		variables.hasResolver      = true;
	}

	/**
	 * Converts an absolute path into one relative to this file's own directory, the only
	 * form BoxLang's `new` accepts for a dynamically-computed class path.
	 */
	private string function toRelativePath( required string absolutePath ){
		var fromParts = listToArray( reReplace( variables.selfDirectory, "[\\/]+$", "" ), "/" );
		var toParts   = listToArray( arguments.absolutePath, "/" );

		var common = 0;
		while( common < arrayLen( fromParts ) && common < arrayLen( toParts ) && fromParts[ common + 1 ] == toParts[ common + 1 ] ){
			common++;
		}

		var upSegments = arrayLen( fromParts ) - common;
		var relativeParts = [];
		for( var i = 1; i <= upSegments; i++ ){
			arrayAppend( relativeParts, ".." );
		}
		for( var i = common + 1; i <= arrayLen( toParts ); i++ ){
			arrayAppend( relativeParts, toParts[ i ] );
		}

		return arrayToList( relativeParts, "/" );
	}

}
