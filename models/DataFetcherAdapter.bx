/**
 * Bridges a single graphql-java DataFetcher call to a plain BoxLang resolver class, per
 * the module's resolver convention. One instance is created per schema type at
 * schema-build time and wrapped as a Java graphql.schema.DataFetcher via createDynamicProxy.
 *
 * Convention: {resolverBasePackage}/{TypeName}Resolver.bx, method {fieldName}().
 * Falls back to reading the field off the parent when no resolver class exists, or the
 * resolver class exists but doesn't implement the specific field method: through
 * graphql-java's PropertyDataFetcher for a struct, readFromInstance() for a class instance.
 *
 * No DI container here (no WireBox equivalent) — resolver existence is checked by
 * fileExists() against the configured resolverBasePackage directory, then instantiated
 * directly via new, rather than by pattern-matching a framework's not-found exception.
 * resolverBasePackage arrives as an absolute directory ("" for none); ClassFiles does
 * the instantiating.
 */
class {

	property name="typeName";
	property name="resolverBasePackage";
	property name="javaClass";
	property name="classFiles";

	variables.authorizer               = "";
	variables.guards                   = {};
	variables.resolverInstance         = "";
	variables.hasResolver              = false;
	variables.resolverChecked          = false;
	variables.propertyDataFetcherCache = {};
	variables.lockName                 = "bxgraphql-resolver-" & createUUID();

	function init(
		required string typeName,
		required string resolverBasePackage,
		required any javaClass,
		any classFiles,
		struct guards = {},
		any authorizer = ""
	){
		variables.classFiles          = arguments.classFiles ?: new "ClassFiles"();
		variables.typeName            = arguments.typeName;
		variables.resolverBasePackage = arguments.resolverBasePackage;
		variables.javaClass           = arguments.javaClass;
		variables.authorizer          = arguments.authorizer;
		variables.guards              = guardsWithResolvers( arguments.guards );

		if( !structIsEmpty( variables.guards ) && isSimpleValue( variables.authorizer ) ){
			throw(
				type    = "BxGraphQL.ConfigurationException",
				message = "#variables.guards[ structKeyArray( variables.guards )[ 1 ] ].where# is marked @graphqlRequires, which needs settings.authorizer: ( requirement, context, info ) => boolean."
			);
		}
		return this;
	}

	/**
	 * The type's guarded fields, { fieldName : { requirement, where } }: those given (a
	 * bean's properties) and the resolver class's guarded methods, read from its
	 * metadata so nothing is instantiated before the first request.
	 */
	private struct function guardsWithResolvers( required struct guards ){
		var all = duplicate( arguments.guards );
		if( !resolverFileExists() ){
			return all;
		}
		var meta = variables.classFiles.metadataOf( resolverPath() );
		for( var fn in variables.classFiles.functionsOf( meta ) ){
			var guard = variables.classFiles.requirementOf( fn.annotations, meta );
			if( fn.access == "public" && guard.guarded ){
				all[ fn.name ] = { "requirement" : guard.requirement, "where" : "#meta.name#.#fn.name#()" };
			}
		}
		return all;
	}

	private string function resolverPath(){
		return variables.resolverBasePackage & "/" & variables.typeName & "Resolver";
	}

	private boolean function resolverFileExists(){
		return len( variables.resolverBasePackage ) && fileExists( expandPath( resolverPath() & ".bx" ) );
	}

	/**
	 * Single abstract method of graphql.schema.DataFetcher.
	 * `environment` is a raw graphql.schema.DataFetchingEnvironment.
	 */
	any function get( required any environment ){
		var fieldName = arguments.environment.getField().getName();

		if( structKeyExists( variables.guards, fieldName ) ){
			new "Authorization"( variables.authorizer ).check(
				requirement = variables.guards[ fieldName ].requirement,
				context     = new "RequestContext"().of( arguments.environment ),
				type        = variables.typeName,
				field       = fieldName,
				args        = new "ArgumentValues"().toBoxLang( arguments.environment.getArguments() )
			);
		}

		ensureResolverResolved();

		if( variables.hasResolver && structKeyExists( variables.resolverInstance, fieldName ) ){
			return variables.resolverInstance[ fieldName ](
				source  = arguments.environment.getSource(),
				args    = new "ArgumentValues"().toBoxLang( arguments.environment.getArguments() ),
				context = new "RequestContext"().of( arguments.environment ),
				env     = arguments.environment
			);
		}

		var source = arguments.environment.getSource();
		if( !isNull( source ) && isInstanceOf( source, "ortus.boxlang.runtime.runnables.IClassRunnable" ) ){
			return readFromInstance( source, fieldName );
		}

		if( !structKeyExists( variables.propertyDataFetcherCache, fieldName ) ){
			variables.propertyDataFetcherCache[ fieldName ] = variables.javaClass.create( "graphql.schema.PropertyDataFetcher" ).fetching( fieldName );
		}
		return variables.propertyDataFetcherCache[ fieldName ].get( arguments.environment );
	}

	/**
	 * graphql-java's PropertyDataFetcher finds nothing on a BoxLang class instance
	 * (every field comes back null, with no error), so those are read here: the
	 * getter, generated by accessors or written by hand, else a public member.
	 */
	private any function readFromInstance( required any source, required string fieldName ){
		if( structKeyExists( arguments.source, "get" & arguments.fieldName ) ){
			return invoke( arguments.source, "get" & arguments.fieldName );
		}
		if( structKeyExists( arguments.source, arguments.fieldName ) && !isCustomFunction( arguments.source[ arguments.fieldName ] ) ){
			return arguments.source[ arguments.fieldName ];
		}
		return javaCast( "null", "" );
	}

	/**
	 * Built on the first request that needs it, and requests arrive together: the lock
	 * lets one build it, and resolverChecked is set last, so no request sees "checked"
	 * before the instance is in place.
	 */
	private void function ensureResolverResolved(){
		if( variables.resolverChecked ){
			return;
		}
		lock name="#variables.lockName#" type="exclusive" timeout="60" {
			if( variables.resolverChecked ){
				return;
			}
			if( resolverFileExists() ){
				variables.resolverInstance = variables.classFiles.build( resolverPath(), "resolver" );
				variables.hasResolver      = true;
			}
			variables.resolverChecked = true;
		}
	}

}
