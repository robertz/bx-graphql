/**
 * Code-first schema: turns annotated classes into SDL, which GraphQLService merges
 * with any hand-written .graphqls files.
 *
 *   modelPaths   — a class marked @graphqlType and/or @graphqlInput becomes a type and/or
 *                  an input, a field per property, plus a field per function marked
 *                  @graphqlField (on the type only); @graphqlImplements( "Node" ) names
 *                  hand-written interfaces the type implements. One marked
 *                  @graphqlEnum( "A,B" ) becomes an enum.
 *   servicePaths — public functions marked @graphqlQuery or @graphqlMutation become
 *                  fields of Query or Mutation.
 *
 * Reads getClassMetadata(), never getMetaData(): with bx-compat-cfml installed the
 * latter folds annotations into the top level and has no `annotations` key at all.
 */
class {

	static {
		// parameters of these names are filled in by MethodDataFetcher, not by the query
		INJECTED_PARAMETERS = [ "context", "env", "args" ];
		NAME_PATTERN        = "^[_A-Za-z][_0-9A-Za-z]*$";
	}

	variables.classFiles = "";

	function init( required any classFiles ){
		variables.classFiles = arguments.classFiles;
		return this;
	}

	/**
	 * @existingTypeNames Types and scalars the hand-written schema already declares.
	 *
	 * @return { sdl,
	 *           models : { SimpleName : { classPath, meta, typeName, inputName, enumName, enumValues } },
	 *           operations : [ { rootType, fieldName, classPath ("" = called on the field's source),
	 *                            methodName, parameters, meta, where, guarded, requirement } ],
	 *           guards : { TypeName : { propertyName : { requirement, where } } } }
	 */
	struct function generate( required array modelPaths, required array servicePaths, required array existingTypeNames ){
		var models     = modelsIn( arguments.modelPaths );
		var mapper     = new "TypeMapper"( models );
		var operations = operationsIn( arguments.servicePaths );
		var blocks     = [];
		var typeTexts  = [];
		var guards     = {};

		for( var simpleName in structKeyArray( models ).sort( "textnocase" ) ){
			var model = models[ simpleName ];
			if( len( model.enumName ) ){
				arrayAppend( blocks, description( model.meta.documentation.hint ?: "", "" ) & "enum #model.enumName# {" & char( 10 ) & char( 9 ) & arrayToList( model.enumValues, char( 10 ) & char( 9 ) ) & char( 10 ) & "}" );
			}
			if( len( model.typeName ) ){
				arrayAppend( blocks, beanBlock( "type", model.typeName, model, mapper, false, operations, typeTexts, models, guards ) );
			}
			if( len( model.inputName ) ){
				arrayAppend( blocks, beanBlock( "input", model.inputName, model, mapper, true, operations, typeTexts, models, guards ) );
			}
		}

		for( var rootType in [ "Query", "Mutation" ] ){
			var fields = operations.filter( ( operation ) => operation.rootType == rootType );
			if( arrayLen( fields ) ){
				var keyword = arrayContains( arguments.existingTypeNames, rootType ) ? "extend type" : "type";
				arrayAppend(
					blocks,
					"#keyword# #rootType# {" & char( 10 )
						& fields.map( ( operation ) => fieldLine( operation.meta, operation.fieldName, operation.where, mapper, operation.meta.annotations.graphqlReturns ?: "", typeTexts, models ) ).toList( char( 10 ) )
						& char( 10 ) & "}"
				);
			}
		}

		var sdl = arrayToList( blocks, char( 10 ) & char( 10 ) );
		for( var scalarName in [ "DateTime", "Long" ] ){
			var used = typeTexts.some( ( typeText ) => reFind( "\b#scalarName#\b", typeText ) > 0 );
			if( used && !arrayContains( arguments.existingTypeNames, scalarName ) ){
				sdl = "scalar #scalarName#" & char( 10 ) & char( 10 ) & sdl;
			}
		}

		return { "sdl" : sdl, "models" : models, "operations" : operations, "guards" : guards };
	}

	private struct function modelsIn( required array modelPaths ){
		var models = {};
		for( var classPath in variables.classFiles.under( arguments.modelPaths, "modelPaths" ) ){
			var meta        = variables.classFiles.metadataOf( classPath );
			var annotations = meta.annotations;
			var isEnum      = structKeyExists( annotations, "graphqlEnum" );
			if( !structKeyExists( annotations, "graphqlType" ) && !structKeyExists( annotations, "graphqlInput" ) && !isEnum ){
				continue;
			}
			if( structKeyExists( models, meta.simpleName ) ){
				throw(
					type    = "BxGraphQL.ConfigurationException",
					message = "Two annotated classes are named #meta.simpleName#: #models[ meta.simpleName ].classPath# and #classPath#. Types are found by a class's simple name, so one has to be renamed."
				);
			}
			if( isEnum && ( structKeyExists( annotations, "graphqlType" ) || structKeyExists( annotations, "graphqlInput" ) ) ){
				throw( type = "BxGraphQL.ConfigurationException", message = "#meta.name# is marked @graphqlEnum, so it can't also be a type or an input." );
			}
			models[ meta.simpleName ] = {
				"classPath"  : classPath,
				"meta"       : meta,
				"typeName"   : structKeyExists( annotations, "graphqlType" ) ? ( len( annotations.graphqlType ) ? annotations.graphqlType : meta.simpleName ) : "",
				"inputName"  : structKeyExists( annotations, "graphqlInput" ) ? ( len( annotations.graphqlInput ) ? annotations.graphqlInput : meta.simpleName & "Input" ) : "",
				"enumName"   : isEnum ? meta.simpleName : "",
				"enumValues" : isEnum ? enumValuesOf( meta ) : []
			};
		}
		return models;
	}

	private array function enumValuesOf( required struct meta ){
		var values = listToArray( arguments.meta.annotations.graphqlEnum, ", " );
		if( !arrayLen( values ) || values.some( ( value ) => !reFind( static.NAME_PATTERN, value ) ) ){
			throw(
				type    = "BxGraphQL.ConfigurationException",
				message = "#arguments.meta.name#: @graphqlEnum needs its values as a list of names, such as @graphqlEnum( ""ACTIVE,PAUSED"" )."
			);
		}
		return values;
	}

	/**
	 * A field may be claimed by more than one scanned class: a parent and the children
	 * that inherit its function, or that override it with the annotation repeated. It
	 * goes to the most-derived of them, so the child's instance is the one called. Two
	 * claimants where neither descends from the other is an error.
	 */
	private array function operationsIn( required array servicePaths ){
		var claims   = {};
		var claimOrder = [];
		for( var classPath in variables.classFiles.under( arguments.servicePaths, "servicePaths" ) ){
			var meta = variables.classFiles.metadataOf( classPath );
			for( var fn in variables.classFiles.functionsOf( meta ) ){
				for( var rootType in [ "Query", "Mutation" ] ){
					if( !structKeyExists( fn.annotations, "graphql" & rootType ) ){
						continue;
					}
					var where = "#meta.name#.#fn.name#()";
					if( fn.access != "public" ){
						throw( type = "BxGraphQL.ConfigurationException", message = "#where# is marked @graphql#rootType# but isn't public." );
					}
					var fieldName = len( fn.annotations[ "graphql" & rootType ] ) ? fn.annotations[ "graphql" & rootType ] : fn.name;
					var claimKey  = rootType & "." & fieldName;
					if( !structKeyExists( claims, claimKey ) ){
						claims[ claimKey ] = [];
						arrayAppend( claimOrder, claimKey );
					}
					arrayAppend( claims[ claimKey ], {
						"className" : meta.name,
						"ancestors" : ancestorNamesOf( meta ),
						"operation" : operationOf( rootType, fieldName, classPath, fn, meta, where )
					} );
				}
			}
		}

		return claimOrder.map( ( claimKey ) => {
			var claimants = claims[ claimKey ];
			for( var candidate in claimants ){
				var others = claimants.filter( ( other ) => other.className != candidate.className );
				if( others.every( ( other ) => arrayContains( candidate.ancestors, other.className ) ) ){
					return candidate.operation;
				}
			}
			throw(
				type    = "BxGraphQL.ConfigurationException",
				message = "#claimKey# is declared twice: by #claimants[ 1 ].operation.where# and #claimants[ 2 ].operation.where#."
			);
		} );
	}

	private array function ancestorNamesOf( required struct meta ){
		var names  = [];
		var parent = arguments.meta.extends ?: {};
		while( !structIsEmpty( parent ) ){
			arrayAppend( names, parent.name );
			parent = parent.extends ?: {};
		}
		return names;
	}

	private struct function operationOf( required string rootType, required string fieldName, required string classPath, required struct fn, required struct classMeta, required string where ){
		var guard = variables.classFiles.requirementOf( arguments.fn.annotations, arguments.classMeta );
		return {
			"rootType"    : arguments.rootType,
			"fieldName"   : arguments.fieldName,
			"classPath"   : arguments.classPath,
			"methodName"  : arguments.fn.name,
			"parameters"  : arguments.fn.parameters,
			"meta"        : arguments.fn,
			"where"       : arguments.where,
			"guarded"     : guard.guarded,
			"requirement" : guard.requirement
		};
	}

	private string function beanBlock(
		required string keyword,
		required string name,
		required struct model,
		required any mapper,
		required boolean forInput,
		required array operations,
		required array typeTexts,
		required struct models,
		required struct guards
	){
		var lines = [];
		if( !arguments.forInput ){
			arguments.guards[ arguments.name ] = {};
		}
		var meta  = arguments.model.meta;
		for( var property in variables.classFiles.propertiesOf( meta ) ){
			var annotations = property.annotations;
			if( structKeyExists( annotations, "graphqlIgnore" )
				|| ( arguments.forInput && structKeyExists( annotations, "graphqlReadOnly" ) )
				|| ( !arguments.forInput && structKeyExists( annotations, "graphqlWriteOnly" ) ) ){
				continue;
			}
			var where = "#meta.name#.#property.name#";
			var fieldType = "";
			if( arguments.forInput && len( annotations.graphqlInputField ?: "" ) ){
				fieldType = annotations.graphqlInputField;
			} else if( len( annotations.graphqlField ?: "" ) ){
				fieldType = annotations.graphqlField;
			} else {
				fieldType = structKeyExists( annotations, "graphqlId" )
					? "ID"
					: arguments.mapper.nameFor( property.type ?: "any", arguments.forInput, where, arguments.forInput ? "@graphqlInputField( ""..."" )" : "@graphqlField( ""..."" )" );
				if( isBoolean( annotations.required ?: "" ) && annotations.required ){
					fieldType &= "!";
				}
			}
			arrayAppend( arguments.typeTexts, fieldType );
			var guard = variables.classFiles.requirementOf( annotations, meta );
			if( !arguments.forInput && guard.guarded ){
				arguments.guards[ arguments.name ][ property.name ] = { "requirement" : guard.requirement, "where" : where };
			}
			arrayAppend(
				lines,
				description( property.documentation.hint ?: "", char( 9 ) ) & char( 9 ) & property.name & ": " & fieldType
					& ( arguments.forInput ? "" : deprecation( annotations, property.documentation ) )
			);
		}

		if( !arguments.forInput ){
			for( var fn in variables.classFiles.functionsOf( meta ) ){
				if( !structKeyExists( fn.annotations, "graphqlField" ) ){
					continue;
				}
				var fnWhere = "#meta.name#.#fn.name#()";
				if( fn.access != "public" ){
					throw( type = "BxGraphQL.ConfigurationException", message = "#fnWhere# is marked @graphqlField but isn't public." );
				}
				arrayAppend( lines, fieldLine( fn, fn.name, fnWhere, arguments.mapper, fn.annotations.graphqlField, arguments.typeTexts, arguments.models ) );
				arrayAppend( arguments.operations, operationOf( arguments.name, fn.name, "", fn, meta, fnWhere ) );
			}
		}

		if( !arrayLen( lines ) ){
			throw(
				type    = "BxGraphQL.ConfigurationException",
				message = "#meta.name# would make #arguments.keyword# #arguments.name# with no fields."
			);
		}
		var implemented = arguments.forInput ? [] : listToArray( meta.annotations.graphqlImplements ?: "", ", &" );
		return description( meta.documentation.hint ?: "", "" ) & "#arguments.keyword# #arguments.name#"
			& ( arrayLen( implemented ) ? " implements " & arrayToList( implemented, " & " ) : "" ) & " {" & char( 10 ) & arrayToList( lines, char( 10 ) ) & char( 10 ) & "}";
	}

	/**
	 * One field made from a function: `name( arguments ): Type`, with its description and
	 * deprecation. Arguments go one to a line when any of them has a description.
	 *
	 * @statedReturn The return type when an annotation gave it verbatim, else "".
	 */
	private string function fieldLine(
		required struct fn,
		required string fieldName,
		required string where,
		required any mapper,
		required string statedReturn,
		required array typeTexts,
		required struct models
	){
		var mapper       = arguments.mapper;
		var where        = arguments.where;
		var typeTexts    = arguments.typeTexts;
		var models       = arguments.models;
		var described    = false;
		var sdlArguments = arguments.fn.parameters
			.filter( ( parameter ) => !arrayContainsNoCase( static.INJECTED_PARAMETERS, parameter.name ) )
			.map( ( parameter ) => {
				var argumentType = len( parameter.annotations.graphqlType ?: "" )
					? parameter.annotations.graphqlType
					: mapper.nameFor( parameter.type ?: "any", true, "#where#'s parameter #parameter.name#", "graphqlType=""..."" on the parameter" ) & ( parameter.required ? "!" : "" );
				arrayAppend( typeTexts, argumentType );
				var hint = parameter.documentation.hint ?: "";
				described = described || len( trim( hint ) ) > 0;
				// with a default the argument is non-null: it can be left out, but null can't
				// reach a BoxLang parameter that has a default, so the schema refuses it
				var defaultText = defaultOf( parameter, argumentType, models );
				if( len( defaultText ) && right( argumentType, 1 ) != "!" ){
					argumentType &= "!";
				}
				return {
					"description" : hint,
					"text"        : parameter.name & ": " & argumentType & defaultText
				};
			} );

		var returnType = len( arguments.statedReturn )
			? arguments.statedReturn
			: arguments.mapper.nameFor( arguments.fn.returnType ?: "any", false, "#where#'s return", "@graphqlReturns( ""..."" )" );
		arrayAppend( arguments.typeTexts, returnType );

		var argumentText = "";
		if( arrayLen( sdlArguments ) && described ){
			argumentText = "(" & char( 10 )
				& sdlArguments.map( ( argument ) => description( argument.description, char( 9 ) & char( 9 ) ) & char( 9 ) & char( 9 ) & argument.text ).toList( char( 10 ) )
				& char( 10 ) & char( 9 ) & ")";
		} else if( arrayLen( sdlArguments ) ){
			argumentText = "( " & sdlArguments.map( ( argument ) => argument.text ).toList( ", " ) & " )";
		}

		return description( arguments.fn.documentation.hint ?: "", char( 9 ) )
			& char( 9 ) & arguments.fieldName & argumentText & ": " & returnType
			& deprecation( arguments.fn.annotations, arguments.fn.documentation );
	}

	/**
	 * ` = value` for an optional parameter whose default is a plain literal that suits its
	 * GraphQL type; "" otherwise, and then the function's own default applies when the
	 * argument is left out, as it does either way.
	 */
	private string function defaultOf( required struct parameter, required string argumentType, required struct models ){
		if( arguments.parameter.required || isNull( arguments.parameter.default ) || !isSimpleValue( arguments.parameter.default ) || find( "[", arguments.argumentType ) ){
			return "";
		}
		var value    = arguments.parameter.default;
		var baseType = reReplace( arguments.argumentType, "[!\s]", "", "all" );
		switch( baseType ){
			case "String": case "ID":
				return " = " & JSONSerialize( toString( value ) );
			case "Boolean":
				return isBoolean( value ) && !isNumeric( value ) ? " = " & ( value ? "true" : "false" ) : "";
			case "Int":
				return isNumeric( value ) && int( value ) == value ? " = " & int( value ) : "";
			case "Float":
				return isNumeric( value ) ? " = " & value : "";
		}
		for( var simpleName in arguments.models ){
			var model = arguments.models[ simpleName ];
			if( model.enumName == baseType && arrayContains( model.enumValues, toString( value ) ) ){
				return " = " & value;
			}
		}
		return "";
	}

	/** From @graphqlDeprecated( "why" ), or a doc comment's @deprecated line. */
	private string function deprecation( required struct annotations, required struct documentation ){
		if( !structKeyExists( arguments.annotations, "graphqlDeprecated" ) && !structKeyExists( arguments.documentation, "deprecated" ) ){
			return "";
		}
		var reason = trim( arguments.annotations.graphqlDeprecated ?: arguments.documentation.deprecated ?: "" );
		return len( reason ) ? " @deprecated( reason: #JSONSerialize( reason )# )" : " @deprecated";
	}

	/**
	 * A block string. A `"""` inside is escaped; text ending in a quote or a backslash
	 * gets a space after it, or it would run into the closing delimiter (`"hi""""`
	 * closes one character early, and `\"""` reads as an escaped delimiter).
	 */
	private string function description( required string text, required string indent ){
		var body = replace( trim( arguments.text ), '"""', '\"""', "all" );
		if( !len( body ) ){
			return "";
		}
		if( right( body, 1 ) == '"' || right( body, 1 ) == "\" ){
			body &= " ";
		}
		return arguments.indent & '"""' & body & '"""' & char( 10 );
	}

}
