/**
 * Finds, describes and instantiates classes by absolute path. BoxLang's `new "path"()`
 * and getClassMetadata() only take a path relative to the file the call is written in
 * (there is no absolute-filesystem-path form), so every absolute path is first made
 * relative to this file's own directory.
 */
class {

	variables.selfDirectory   = getDirectoryFromPath( getCurrentTemplatePath() );
	variables.instanceFactory = "";

	/** @instanceFactory settings.instanceFactory: ( classPath, meta, kind ) => instance. */
	function withFactory( required any instanceFactory ){
		variables.instanceFactory = arguments.instanceFactory;
		return this;
	}

	/**
	 * An instance for the module's own use, from the app's factory when it gave one.
	 *
	 * @kind "service" and "resolver" (built once, kept) or "input" (built per argument).
	 */
	any function build( required string classPath, required string kind ){
		if( isSimpleValue( variables.instanceFactory ) ){
			return instantiate( arguments.classPath );
		}
		var instance = variables.instanceFactory( arguments.classPath, metadataOf( arguments.classPath ), arguments.kind );
		if( isNull( instance ) || !isObject( instance ) ){
			throw( type = "BxGraphQL.ConfigurationException", message = "instanceFactory returned no instance for the #arguments.kind# #arguments.classPath#." );
		}
		return instance;
	}

	/** A class's properties, its parents' first; a child's redeclaration replaces the parent's in place. */
	array function propertiesOf( required struct meta ){
		return inheritedMembers( arguments.meta, "properties" );
	}

	/** A class's functions, its parents' first; an override replaces the parent's in place. Each says where it was `declaredIn`. */
	array function functionsOf( required struct meta ){
		return inheritedMembers( arguments.meta, "functions" );
	}

	/**
	 * What @graphqlRequires asks of one member: its own annotation, even when empty, else
	 * the class's. BoxLang doesn't hand a class's annotations down to its children, so the
	 * class's is looked for up through its parents, and the nearest applies.
	 *
	 * @return { guarded, requirement }
	 */
	struct function requirementOf( required struct memberAnnotations, required struct classMeta ){
		if( structKeyExists( arguments.memberAnnotations, "graphqlRequires" ) ){
			return { "guarded" : true, "requirement" : arguments.memberAnnotations.graphqlRequires };
		}
		var guardClass = arguments.classMeta;
		while( !structIsEmpty( guardClass ) && !structKeyExists( guardClass.annotations ?: {}, "graphqlRequires" ) ){
			guardClass = guardClass.extends ?: {};
		}
		return structIsEmpty( guardClass )
			? { "guarded" : false, "requirement" : "" }
			: { "guarded" : true, "requirement" : guardClass.annotations.graphqlRequires };
	}

	private array function inheritedMembers( required struct meta, required string kind ){
		var members = structIsEmpty( arguments.meta.extends ?: {} ) ? [] : inheritedMembers( arguments.meta.extends, arguments.kind );
		for( var declared in arguments.meta[ arguments.kind ] ?: [] ){
			var member     = duplicate( declared ).append( { "declaredIn" : arguments.meta.name } );
			var memberName = member.name;
			var at         = members.find( ( candidate ) => candidate.name == memberName );
			if( at ){
				members[ at ] = member;
			} else {
				arrayAppend( members, member );
			}
		}
		return members;
	}

	/** Absolute paths, without the extension, of every .bx class under the given files and directories (recursively). */
	array function under( required array configuredPaths, required string settingName ){
		var found = [];
		for( var rawPath in arguments.configuredPaths ){
			var expandedPath = expandPath( rawPath );
			if( directoryExists( expandedPath ) ){
				arrayAppend( found, directoryList( expandedPath, true, "path", "*.bx" ), true );
			} else if( fileExists( expandedPath ) ){
				arrayAppend( found, expandedPath );
			} else if( fileExists( expandedPath & ".bx" ) ){
				arrayAppend( found, expandedPath & ".bx" );
			} else {
				throw(
					type    = "BxGraphQL.ConfigurationException",
					message = "Configured #arguments.settingName# entry does not exist: " & rawPath & " (resolved to " & expandedPath & ")"
				);
			}
		}
		arraySort( found, "text" );
		return found.map( ( filePath ) => reReplace( filePath, "\.bx$", "" ) );
	}

	struct function metadataOf( required string classPath ){
		return getClassMetadata( toRelativePath( arguments.classPath ) );
	}

	any function instantiate( required string classPath ){
		return new "#toRelativePath( arguments.classPath )#"();
	}

	string function toRelativePath( required string absolutePath ){
		var fromParts = listToArray( reReplace( variables.selfDirectory, "[\\/]+$", "" ), "/\" );
		var toParts   = listToArray( arguments.absolutePath, "/\" );

		var common = 0;
		while( common < arrayLen( fromParts ) && common < arrayLen( toParts ) && fromParts[ common + 1 ] == toParts[ common + 1 ] ){
			common++;
		}

		var relativeParts = [];
		for( var i = 1; i <= arrayLen( fromParts ) - common; i++ ){
			arrayAppend( relativeParts, ".." );
		}
		for( var i = common + 1; i <= arrayLen( toParts ); i++ ){
			arrayAppend( relativeParts, toParts[ i ] );
		}

		return arrayToList( relativeParts, "/" );
	}

}
