class extends="../support/BaseService" {

	/** One widget by id. */
	@graphqlQuery
	Widget function widget( required numeric id graphqlType="ID!" ){
		return new "../models/Widget"(
			id           = arguments.id,
			name         = "Widget #arguments.id#",
			price        = 9.5,
			stock        = 3,
			active       = true,
			status       = "ACTIVE",
			maker        = new "../models/Maker"( name = "Acme" ),
			tags         = [ new "../models/Tag"( label = "new" ) ],
			passwordHash = "hunter2",
			createdAt    = createDateTime( 2026, 1, 31, 9, 30, 0, 0, "UTC" )
		);
	}

	@graphqlQuery
	@graphqlReturns( "[Widget!]!" )
	array function widgets( numeric limit = 2 ){
		var found = [];
		for( var i = 1; i <= arguments.limit; i++ ){
			arrayAppend( found, widget( i ) );
		}
		return found;
	}

	@graphqlQuery
	string function whoAmI( struct context, any env ){
		return arguments.context.user & " asked for " & arguments.env.getField().getName();
	}

	@graphqlMutation
	@graphqlReturns( "String!" )
	string function saveWidget( required Widget input ){
		return [
			getMetadata( arguments.input ).name.listLast( "." ),
			arguments.input.getName(),
			isNull( arguments.input.getMaker() ) ? "no maker" : arguments.input.getMaker().getName(),
			arrayToList( arguments.input.getTags() ?: [] ),
			isNull( arguments.input.getStock() ) ? "no stock" : arguments.input.getStock()
		].toList( "|" );
	}

	@graphqlMutation( "renameWidget" )
	Widget function rename( required numeric id graphqlType="ID!", required string name ){
		var found = widget( arguments.id );
		found.setName( arguments.name );
		return found;
	}

	/**
	 * Widgets in one state.
	 *
	 * @status Which state.
	 * @deprecated Use widgets.
	 */
	@graphqlQuery
	string function widgetsByStatus( string status = "ACTIVE" graphqlType="Status", string order = "name", boolean reverse = false ){
		return arguments.status & " by " & arguments.order;
	}

	@graphqlQuery
	string function soldSince( required date since ){
		return arguments.since.toInstant().toString();
	}

	@graphqlQuery
	@graphqlReturns( "[Widget!]!" )
	array function fromMakers( required array makerIds graphqlType="[Int!]!" ){
		return arguments.makerIds.map( ( makerId ) => new "../models/Widget"( id = makerId, name = "From #makerId#", makerId = makerId ) );
	}

	@graphqlMutation
	@graphqlReturns( "[String!]!" )
	array function describeInput( required Widget input, struct args ){
		var input = arguments.input;
		return [
			"labels: " & ( input.getLabels() ?: [] ).map( ( label ) => getMetadata( label ).name.listLast( "." ) & ":" & label.getLabel() ).toList(),
			"related: " & ( input.getRelated() ?: [] ).map( ( tag ) => getMetadata( tag ).name.listLast( "." ) & ":" & tag.getLabel() ).toList(),
			"soldAt: " & ( isNull( input.getSoldAt() ) ? "none" : input.getSoldAt().toInstant().toString() ),
			"status: " & ( input.getStatus() ?: "none" ),
			"price: " & ( isNull( input.getPrice() ) ? "null" : input.getPrice() ),
			"price given: " & arrayContainsNoCase( structKeyArray( arguments.args.input ), "price" ),
			"stock given: " & arrayContainsNoCase( structKeyArray( arguments.args.input ), "stock" )
		];
	}

	@graphqlQuery
	string function tagged( string tag = lcase( "DEFAULT" ) ){
		return arguments.tag;
	}

	@graphqlQuery
	string function echoed( string word ){
		return isNull( arguments.word ) ? "nothing" : arguments.word;
	}

	string function notExposed(){
		return "no";
	}

	private string function helper(){
		return "no";
	}

}
