/** A thing we sell. */
@graphqlType
@graphqlInput
class accessors="true" extends="Timestamped" {

	@graphqlId
	property name="id" type="numeric";

	/** What it's called on the shelf. */
	property name="name" type="string" required="true";

	property name="price" type="numeric";
	property name="stock" type="integer";
	property name="active" type="boolean";
	property name="maker" type="Maker";

	@graphqlField( "[Tag!]" )
	@graphqlInputField( "[String!]" )
	property name="tags" type="array";

	@graphqlIgnore
	property name="passwordHash" type="string";

	@graphqlField( "Status" )
	property name="status" type="string";
	property name="soldAt" type="date";
	property name="makerId" type="numeric";

	@graphqlInputField( "[TagInput!]" )
	@graphqlWriteOnly
	property name="labels" type="array";

	property name="related" type="Tag[]";

	/** Use name. */
	@graphqlDeprecated( "Use name" )
	property name="title" type="string";

	/**
	 * The name, as a URL would have it.
	 *
	 * @separator What goes between the words.
	 */
	@graphqlField
	string function slug( string separator = "-" ){
		return lcase( replace( variables.name, " ", arguments.separator, "all" ) );
	}

	@graphqlField( "Maker" )
	function madeBy( any env ){
		return isNull( variables.makerId ) ? javaCast( "null", "" ) : arguments.env.getDataLoader( "makers" ).load( variables.makerId );
	}

	@graphqlField
	string function label( string status = "ACTIVE" graphqlType="Status" ){
		return variables.name & " (" & arguments.status & ")";
	}

	@graphqlField
	@graphqlRequires( "admin" )
	numeric function cost(){
		return 4.25;
	}

}
